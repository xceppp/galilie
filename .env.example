# CMS admin panel (see docs/cms-setup.md)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
ADMIN_EMAILS=you@gmail.com
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Reused from lead API (same spreadsheet; CMS adds cms_* tabs)
GOOGLE_SHEETS_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Lead form (api/lead.js)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=www.ncconsulting.ma,ncconsulting.ma

# Email when form submits (Resend — optional if Apps Script MailApp is used)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=chaltoutenouamane@gmail.com

# Optional tab names (defaults: Conseil, Formation, General)
# SHEET_TAB_CONSULTING=Conseil
# SHEET_TAB_FORMATION=Formation
# SHEET_TAB_GENERAL=General
