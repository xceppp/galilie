    },
    {
      "source": "/blog/fsjes-meknes-licence-master-excellence",
      "destination": "/blog/fsjes-meknes-licence-master-excellence.html",
      "permanent": true
    },
    {
      "source": "/blog/licence-master-excellence-meknes",
      "destination": "/blog/licence-master-excellence-meknes.html",
      "permanent": true
    },
    {
      "source": "/blog/licence-master-temps-amenage-reprendre-etudes",
      "destination": "/blog/licence-master-temps-amenage-reprendre-etudes.html",
      "permanent": true
    },
    {
      "source": "/blog/licence-temps-amenage",
      "destination": "/blog/licence-temps-amenage.html",
      "permanent": true
    },
    {
      "source": "/blog/licence-vs-master-excellence-preparation",
      "destination": "/blog/licence-vs-master-excellence-preparation.html",
      "permanent": true
    },
    {
      "source": "/blog/master-temps-amenage",
      "destination": "/blog/master-temps-amenage.html",
